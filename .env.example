# Copy this file to .env and fill in your own keys. Never commit .env.

COMPANY_NAME=Nimbus Cloud
AGENT_NAME=Ramp

# Model: azure, groq, openai or mock (mock needs no key and is for building screens)
LLM_PROVIDER=mock

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Memory: Hindsight Cloud. Leave the key empty to use local memory while developing.
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
BANK_PREFIX=nimbus

# Handbook pages older than this are treated as possibly outdated
STALE_AFTER_DAYS=365
